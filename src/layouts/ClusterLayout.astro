---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { Image } from 'astro:assets';
import { CLUSTERS, getPublished, urlFor, type ClusterId } from '../utils/clusters.ts';
import { CLUSTER_IMAGE, CLUSTER_ALT } from '../utils/images.ts';

/**
 * `faqs` alimenta a la vez el bloque visible y el JSON-LD `FAQPage`. Duplicarlos a mano
 * sería la forma más fácil de que se desincronicen y Google marque datos estructurados
 * que no aparecen en la página.
 */
interface Props {
  cluster: ClusterId;
  faqs?: { q: string; a: string }[];
}
const { cluster, faqs = [] } = Astro.props;

const meta = CLUSTERS[cluster];
const entries = await getPublished(cluster);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: meta.title,
    description: meta.description,
    inLanguage: 'es',
  },
  ...(faqs.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: faqs.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ]
    : []),
];
---
<BaseLayout title={meta.title} description={meta.description} jsonLd={jsonLd}>
  <div class="cluster" style={`--color-cat: ${meta.color}`}>
  <header class="cluster-head">
    <Image
      class="cluster-head__img"
      src={CLUSTER_IMAGE[cluster]}
      alt={CLUSTER_ALT[cluster]}
      widths={[640, 1200]}
      sizes="100vw"
      loading="eager"
      quality={70}
    />
    <div class="cluster-head__veil"></div>
    <div class="wrap cluster-head__content">
      <Breadcrumb items={[{ label: meta.label, href: meta.base }]} />
      <h1>{meta.title}</h1>
      <p>{meta.intro}</p>
      <p class="cluster-head__count">{entries.length} {entries.length === 1 ? 'recurso disponible' : 'recursos disponibles'}</p>
    </div>
  </header>

  <div class="wrap section">

    {entries.length === 0 ? (
      <p class="empty">Estamos preparando los primeros recursos de esta sección.</p>
    ) : (
      <ul class="grid-cards">
        {entries.map((entry) => (
          <ResourceCard
            href={urlFor(cluster, entry.id)}
            title={entry.data.title}
            category={entry.data.category}
            age_range={entry.data.age_range}
            duration={entry.data.duration}
            participants={entry.data.participants}
            materials={entry.data.materials}
            color={meta.color}
          />
        ))}
      </ul>
    )}
  </div>

  {/* La guía va DEBAJO de la rejilla a propósito: quien llega busca el listado,
      no un artículo. Enterrar las fichas bajo mil palabras castiga la experiencia
      y con ella el tiempo de permanencia. */}
  <section class="wrap section guia prose">
    <slot name="guia" />
  </section>

  {faqs.length > 0 && (
    <section class="section section--alt">
      <div class="wrap faq-wrap">
        <h2>Preguntas frecuentes</h2>
        <div class="faqs">
          {faqs.map((f) => (
            <details class="faq">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}
  </div>
</BaseLayout>

<style>
  .cluster-head { position: relative; isolation: isolate; }
  .cluster-head__img {
    position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%;
    object-fit: cover; filter: saturate(.8) brightness(.7);
  }
  .cluster-head__veil {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, rgb(10 10 15 / 0.62) 0%, var(--color-bg) 100%),
      linear-gradient(100deg, color-mix(in srgb, var(--color-cat) 30%, transparent) 0%, transparent 70%);
  }
  .cluster-head__content { padding-block: var(--space-7); color: #fff; }
  .cluster-head h1 { color: #fff; max-width: 20ch; }
  .cluster-head p { color: var(--color-ink-soft); max-width: var(--measure); margin-bottom: 0; }
  .cluster-head__count {
    margin-top: var(--space-4) !important; font-size: var(--text-small); font-weight: 600;
    color: color-mix(in srgb, var(--color-cat) 72%, #fff) !important;
  }
  /* Migas sobre imagen: hay que aclararlas o no se leen. */
  .cluster-head :global(.breadcrumb a),
  .cluster-head :global(.breadcrumb span),
  .cluster-head :global(.breadcrumb ol) { color: var(--color-ink-soft); }

  .empty { color: var(--color-ink-soft); }

  /* Sin contenido en el slot la sección no debe dejar un hueco vertical. */
  .guia:not(:has(*)) { display: none; }
  .guia :global(h2:first-child) { margin-top: 0; }

  .faq-wrap { max-width: 46rem; }
  .faq-wrap h2 { margin-bottom: var(--space-5); }
  .faqs { display: grid; gap: var(--space-3); }
  .faq {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); padding: var(--space-4) var(--space-5);
  }
  .faq[open] { border-color: color-mix(in srgb, var(--color-cat) 35%, var(--color-border)); }
  .faq summary { cursor: pointer; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: var(--space-4); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: '+'; color: color-mix(in srgb, var(--color-cat) 72%, #fff);
    font-size: 1.5rem; line-height: 1; font-weight: 400;
  }
  .faq[open] summary::after { content: '−'; }
  .faq p { margin: var(--space-3) 0 0; color: var(--color-ink-soft); }
</style>
