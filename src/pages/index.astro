---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { SITE } from '../site.config.mjs';
import { PRIMARY_CLUSTERS, getPublished, urlFor, type ClusterId } from '../utils/clusters.ts';
import { CLUSTER_IMAGE, CLUSTER_ALT } from '../utils/images.ts';

// Orden de la Home según §7 del MASTER_PLAN. El buscador y los productos
// entran cuando el contenido y la oferta los justifiquen (§16, §17).
const dinamicas = await getPublished('dinamicas');
const juegos = await getPublished('juegos');

const counts: Record<string, number> = {
  dinamicas: dinamicas.length,
  juegos: juegos.length,
};

const destacados = [
  ...dinamicas.map((e) => ({ cluster: 'dinamicas' as const, entry: e })),
  ...juegos.map((e) => ({ cluster: 'juegos' as const, entry: e })),
]
  .sort((a, b) => Number(b.entry.data.featured) - Number(a.entry.data.featured))
  .slice(0, 6);

const pasos = [
  {
    n: '01',
    t: 'Elige la categoría',
    d: 'Dinámicas para romper el hielo o juegos bíblicos para repasar la Palabra.',
  },
  {
    n: '02',
    t: 'Mira la ficha',
    d: 'Edad, participantes, duración y materiales visibles antes de entrar.',
  },
  {
    n: '03',
    t: 'Llévalo a tu reunión',
    d: 'Instrucciones paso a paso, variantes y reflexión bíblica para cerrar.',
  },
];

const faqs = [
  {
    q: '¿Los recursos son gratuitos?',
    a: 'Sí. Todas las dinámicas, juegos bíblicos y temas publicados en la web se pueden usar libremente en tu grupo juvenil o iglesia.',
  },
  {
    q: '¿Para qué edades sirven?',
    a: 'Cada recurso indica su edad recomendada, normalmente entre los 12 y los 18 años, además del número de participantes y la duración.',
  },
  {
    q: '¿Necesito materiales especiales?',
    a: 'No siempre. Cada ficha lista los materiales necesarios y muchas dinámicas están pensadas para hacerse sin material alguno.',
  },
  {
    q: '¿Sirven también para grupos de adultos?',
    a: 'Sí. Hay una sección específica de dinámicas cristianas para adultos, pensada para células, grupos pequeños y reuniones de iglesia.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    inLanguage: 'es',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BaseLayout title={SITE.title} description={SITE.description} jsonLd={jsonLd}>
  <Hero />

  <section class="section wrap">
    <div class="section__head">
      <span class="eyebrow">Categorías</span>
      <h2>Empieza por lo que necesitas hoy</h2>
      <p>Cada recurso incluye su ficha práctica completa. Nada de teoría: material para usar.</p>
    </div>
    <ul class="grid-cards">
      {PRIMARY_CLUSTERS.map((cluster) => (
        <CategoryCard
          href={cluster.base}
          label={cluster.label}
          text={cluster.intro}
          image={CLUSTER_IMAGE[cluster.id as ClusterId]}
          alt={CLUSTER_ALT[cluster.id as ClusterId]}
          count={counts[cluster.id] ?? 0}
        />
      ))}
    </ul>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="section__head">
        <span class="eyebrow">Cómo funciona</span>
        <h2>De la búsqueda a la reunión en tres pasos</h2>
      </div>
      <ol class="steps">
        {pasos.map((p) => (
          <li>
            <span class="steps__n">{p.n}</span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {destacados.length > 0 && (
    <section class="section wrap">
      <div class="section__head">
        <span class="eyebrow">Destacados</span>
        <h2>Los recursos que más se usan</h2>
      </div>
      <ul class="grid-cards">
        {destacados.map(({ cluster, entry }) => (
          <ResourceCard
            href={urlFor(cluster, entry.id)}
            title={entry.data.title}
            category={entry.data.category}
            age_range={entry.data.age_range}
            duration={entry.data.duration}
            participants={entry.data.participants}
            materials={entry.data.materials}
          />
        ))}
      </ul>
    </section>
  )}

  <section class="section section--alt">
    <div class="wrap faq-wrap">
      <div class="section__head">
        <span class="eyebrow">Dudas frecuentes</span>
        <h2>Preguntas frecuentes</h2>
      </div>
      <div class="faqs">
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .steps {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    counter-reset: step;
  }
  .steps li {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); padding: var(--space-5);
  }
  .steps__n {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.5rem; height: 2.5rem; border-radius: var(--radius-md);
    background: var(--color-brand-soft); color: var(--color-brand-dark);
    font-weight: 800; margin-bottom: var(--space-3);
  }
  .steps h3 { font-size: 1.125rem; margin-bottom: var(--space-2); }
  .steps p { margin: 0; color: var(--color-ink-soft); font-size: var(--text-small); }

  .faq-wrap { max-width: 46rem; }
  .faqs { display: grid; gap: var(--space-3); }
  .faq {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); padding: var(--space-4) var(--space-5);
  }
  .faq summary { cursor: pointer; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: var(--space-4); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; color: var(--color-brand); font-size: 1.5rem; line-height: 1; font-weight: 400; }
  .faq[open] summary::after { content: '−'; }
  .faq p { margin: var(--space-3) 0 0; color: var(--color-ink-soft); }
</style>
