---
interface Props { title: string; text: string; href: string; label: string }
const { title, text, href, label } = Astro.props;
---
<aside class="cta">
  <h2>{title}</h2>
  <p>{text}</p>
  <a class="btn" href={href}>{label}</a>
</aside>

<style>
  .cta { margin-block: var(--space-7); padding: var(--space-6); border-radius: var(--radius-lg); background: var(--color-surface-alt); border: 1px solid var(--color-border); }
  .cta h2 { font-size: var(--text-h3); }
  .cta p { color: var(--color-ink-soft); }
</style>
