---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  label: string;
  text: string;
  image: ImageMetadata;
  alt: string;
  count: number;
}
const { href, label, text, image, alt, count } = Astro.props;
---
<li class="cat">
  <div class="cat__media">
    <Image src={image} alt={alt} widths={[400, 800]} sizes="(min-width: 48rem) 30vw, 100vw" quality={70} />
  </div>
  <div class="cat__body">
    <h3><a href={href}>{label}</a></h3>
    <p>{text}</p>
    <span class="cat__count">{count} {count === 1 ? 'recurso' : 'recursos'}</span>
  </div>
</li>

<style>
  .cat {
    position: relative; display: flex; flex-direction: column;
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-lg); overflow: hidden;
    box-shadow: var(--shadow-card); transition: box-shadow .2s, transform .2s;
  }
  .cat:hover { box-shadow: var(--shadow-lift); transform: translateY(-3px); }
  .cat__media { aspect-ratio: 16 / 10; overflow: hidden; background: var(--color-surface-alt); }
  .cat__media :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s; }
  .cat:hover .cat__media :global(img) { transform: scale(1.04); }
  .cat__body { padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-2); flex: 1; }
  .cat__body h3 { margin: 0; font-size: var(--text-h3); }
  .cat__body h3 a { color: var(--color-ink); text-decoration: none; }
  /* La tarjeta entera es clicable, sin JavaScript. */
  .cat__body h3 a::after { content: ''; position: absolute; inset: 0; }
  .cat__body p { margin: 0; color: var(--color-ink-soft); font-size: var(--text-small); }
  .cat__count { margin-top: auto; padding-top: var(--space-3); font-size: var(--text-small); font-weight: 600; color: var(--color-brand-dark); }
</style>
