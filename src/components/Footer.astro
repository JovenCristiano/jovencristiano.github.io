---
import { NAV, SITE } from '../site.config.mjs';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <p class="site-footer__brand">{SITE.name}</p>
    <p class="site-footer__claim">Recursos cristianos listos para usar con jóvenes.</p>
    <nav aria-label="Navegación del pie">
      <ul>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/contacto/">Contacto</a></li>
      </ul>
    </nav>
    <p class="site-footer__legal">© {year} {SITE.name}</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-surface-alt); border-top: 1px solid var(--color-border); padding-block: var(--space-7); margin-top: var(--space-8); }
  .site-footer__brand { font-weight: 700; margin-bottom: var(--space-1); }
  .site-footer__claim { color: var(--color-ink-soft); }
  .site-footer ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-5); }
  .site-footer__legal { color: var(--color-ink-soft); font-size: var(--text-small); margin: 0; }
</style>
