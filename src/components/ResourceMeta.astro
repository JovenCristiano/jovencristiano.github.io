---
interface Props {
  age_range: string;
  participants: string;
  duration: string;
  difficulty: string;
  materials: string[];
}
const { age_range, participants, duration, difficulty, materials } = Astro.props;

const DIFFICULTY: Record<string, string> = { facil: 'Fácil', media: 'Media', alta: 'Alta' };
---
<!-- La ficha práctica es el diferencial frente a un blog: nunca se oculta tras un clic. -->
<dl class="meta">
  <div><dt>Edad</dt><dd>{age_range}</dd></div>
  <div><dt>Participantes</dt><dd>{participants}</dd></div>
  <div><dt>Duración</dt><dd>{duration}</dd></div>
  <div><dt>Dificultad</dt><dd>{DIFFICULTY[difficulty] ?? difficulty}</dd></div>
  <div><dt>Materiales</dt><dd>{materials.length ? materials.join(', ') : 'Ninguno'}</dd></div>
</dl>

<style>
  .meta {
    display: grid; gap: var(--space-4); margin: 0 0 var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    padding: var(--space-5); background: var(--color-surface-alt);
    border: 1px solid var(--color-border); border-radius: var(--radius-md);
  }
  dt { font-size: var(--text-small); color: var(--color-ink-soft); text-transform: uppercase; letter-spacing: .03em; }
  dd { margin: var(--space-1) 0 0; font-weight: 600; }
</style>
