---
// Las guías para líderes no tienen edad ni participantes: los campos son opcionales
// y la ficha solo muestra los que existen. Si no hay ninguno, no se pinta nada.
interface Props {
  age_range?: string;
  participants?: string;
  duration?: string;
  difficulty?: string;
  materials?: string[];
}
const { age_range, participants, duration, difficulty, materials } = Astro.props;

const DIFFICULTY: Record<string, string> = { facil: 'Fácil', media: 'Media', alta: 'Alta' };

const campos = [
  age_range && { t: 'Edad', v: `${age_range} años` },
  participants && { t: 'Participantes', v: participants },
  duration && { t: 'Duración', v: duration },
  difficulty && { t: 'Dificultad', v: DIFFICULTY[difficulty] ?? difficulty },
].filter(Boolean) as { t: string; v: string }[];

const hayMateriales = materials !== undefined;
---
<!-- La ficha práctica es el diferencial frente a un blog: nunca se oculta tras un clic. -->
{(campos.length > 0 || hayMateriales) && (
  <dl class="meta">
    {campos.map((c) => (
      <div><dt>{c.t}</dt><dd>{c.v}</dd></div>
    ))}
    {hayMateriales && (
      <div class="meta__wide">
        <dt>Materiales</dt>
        <dd>{materials!.length ? materials!.join(' · ') : 'Ninguno'}</dd>
      </div>
    )}
  </dl>
)}

<style>
  .meta {
    display: grid; gap: var(--space-4) var(--space-5); margin: 0 0 var(--space-7);
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    padding: var(--space-5);
    background: color-mix(in srgb, var(--color-cat) 8%, var(--color-surface));
    border: 1px solid color-mix(in srgb, var(--color-cat) 30%, transparent);
    border-radius: var(--radius-lg);
  }
  .meta__wide {
    grid-column: 1 / -1; padding-top: var(--space-4);
    border-top: 1px solid color-mix(in srgb, var(--color-cat) 25%, transparent);
  }
  dt {
    font-family: var(--font-display); font-size: 0.6875rem; font-weight: 800;
    color: color-mix(in srgb, var(--color-cat) 72%, #fff); text-transform: uppercase; letter-spacing: .1em;
  }
  dd { margin: var(--space-1) 0 0; font-weight: 600; font-size: 1.0625rem; color: #fff; }
</style>
