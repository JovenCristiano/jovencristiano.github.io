---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero.jpg';
---
<section class="hero">
  <!-- `loading="eager"` y `fetchpriority="high"`: es el LCP de la Home. -->
  <Image
    class="hero__img"
    src={heroImage}
    alt=""
    widths={[640, 1024, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    quality={70}
  />
  <div class="hero__veil"></div>

  <div class="wrap hero__content">
    <p class="hero__eyebrow">Biblioteca de recursos cristianos</p>
    <h1>Recursos cristianos para transformar tus reuniones con jóvenes</h1>
    <p class="hero__sub">
      Dinámicas, juegos bíblicos, actividades y temas listos para usar. Con edad, duración,
      materiales e instrucciones paso a paso: todo lo que un líder necesita para el domingo.
    </p>
    <p class="hero__actions">
      <a class="btn" href="/dinamicas/">Explorar recursos</a>
      <a class="btn btn--ghost" href="/juegos-biblicos/">Ver juegos bíblicos</a>
    </p>
    <ul class="hero__facts">
      <li>Gratis y sin registro</li>
      <li>Con reflexión bíblica</li>
      <li>Probados en grupos reales</li>
    </ul>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; display: grid; min-height: 32rem; align-content: center; }
  .hero__img {
    position: absolute; inset: 0; z-index: -2;
    width: 100%; height: 100%; object-fit: cover; object-position: center bottom;
  }
  /* Velo doble: oscurece lo justo para cumplir contraste AA sobre cualquier zona de la foto. */
  .hero__veil {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, rgb(15 23 42 / 0.35) 0%, rgb(15 23 42 / 0.72) 100%),
      linear-gradient(90deg, rgb(29 78 216 / 0.45) 0%, rgb(15 23 42 / 0.15) 70%);
  }
  .hero__content { padding-block: var(--space-8) var(--space-7); color: #fff; }
  .hero__eyebrow {
    display: inline-block; margin: 0 0 var(--space-4);
    padding: var(--space-1) var(--space-3); border-radius: 999px;
    background: rgb(255 255 255 / 0.16); border: 1px solid rgb(255 255 255 / 0.28);
    font-size: var(--text-small); font-weight: 600;
  }
  .hero h1 { color: #fff; max-width: 16ch; font-size: clamp(2rem, 6vw, 3.5rem); }
  .hero__sub { max-width: 52ch; color: rgb(248 250 252 / 0.92); font-size: 1.0625rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: var(--space-6) 0 0; }
  .hero__facts {
    list-style: none; padding: 0; margin: var(--space-6) 0 0;
    display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-5);
    font-size: var(--text-small); color: rgb(248 250 252 / 0.85);
  }
  .hero__facts li { display: flex; align-items: center; gap: var(--space-2); }
  .hero__facts li::before {
    content: ''; width: 8px; height: 8px; border-radius: 50%;
    background: var(--color-accent); flex: none;
  }

  @media (min-width: 48rem) {
    .hero__content { padding-block: var(--space-9) var(--space-8); }
    .hero__sub { font-size: 1.25rem; }
  }
</style>
