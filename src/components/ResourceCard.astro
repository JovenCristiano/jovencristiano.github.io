---
interface Props {
  href: string;
  title: string;
  category: string;
  age_range: string;
  duration: string;
  participants: string;
  materials: string[];
}
const { href, title, category, age_range, duration, participants, materials } = Astro.props;
---
<li class="card">
  <p class="card__cat">{category}</p>
  <h3 class="card__title"><a href={href}>{title}</a></h3>
  <ul class="card__facts">
    <li>{age_range} años</li>
    <li>{participants} personas</li>
    <li>{duration}</li>
    <li>{materials.length ? `${materials.length} materiales` : 'Sin materiales'}</li>
  </ul>
</li>

<style>
  .card {
    display: flex; flex-direction: column; gap: var(--space-2);
    padding: var(--space-5); background: var(--color-surface);
    border: 1px solid var(--color-border); border-radius: var(--radius-md);
    box-shadow: var(--shadow-card); transition: box-shadow .15s, transform .15s;
  }
  .card:hover { box-shadow: var(--shadow-hover); transform: translateY(-2px); }
  .card__cat { margin: 0; font-size: var(--text-small); color: var(--color-brand-dark); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
  .card__title { margin: 0; font-size: var(--text-h3); }
  .card__title a { color: var(--color-ink); text-decoration: none; }
  /* Toda la tarjeta es clicable sin JavaScript. */
  .card__title a::after { content: ''; position: absolute; inset: 0; }
  .card { position: relative; }
  .card__facts { list-style: none; padding: 0; margin: auto 0 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); font-size: var(--text-small); color: var(--color-ink-soft); }
</style>
