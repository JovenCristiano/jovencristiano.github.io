---
interface Props {
  href: string;
  title: string;
  category: string;
  age_range: string;
  duration: string;
  participants: string;
  materials: string[];
  color: string;
}
const { href, title, category, age_range, duration, participants, materials, color } = Astro.props;
---
<li class="card" style={`--color-cat: ${color}`}>
  <p class="card__cat"><span class="chip">{category}</span></p>
  <h3 class="card__title"><a href={href}>{title}</a></h3>
  <ul class="card__facts">
    <li>{age_range} años</li>
    <li>{participants} personas</li>
    <li>{duration}</li>
    <li>{materials.length ? `${materials.length} materiales` : 'Sin materiales'}</li>
  </ul>
</li>

<style>
  .card {
    display: flex; flex-direction: column; gap: var(--space-3);
    padding: var(--space-5); background: var(--color-surface);
    border: 1px solid var(--color-border); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card); transition: box-shadow .2s, transform .2s, border-color .2s;
  }
  .card:hover {
    box-shadow: var(--shadow-lift); transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--color-cat) 45%, var(--color-border));
  }
  /* Filo de color: identifica la categoría de un vistazo. */
  .card::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 3px;
    background: var(--color-cat); border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }
  .card__cat { margin: 0; }
  .card__title { margin: 0; font-size: var(--text-h3); }
  .card__title a { color: var(--color-ink); text-decoration: none; }
  .card:hover .card__title a { color: color-mix(in srgb, var(--color-cat) 72%, #fff); }
  /* Toda la tarjeta es clicable sin JavaScript. */
  .card__title a::after { content: ''; position: absolute; inset: 0; }
  .card { position: relative; }
  .card__facts {
    list-style: none; padding: var(--space-3) 0 0; margin: auto 0 0;
    border-top: 1px solid var(--color-border);
    display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3);
    font-size: var(--text-small); color: var(--color-ink-soft);
  }
  .card__facts li + li::before { content: '·'; margin-right: var(--space-3); color: var(--color-ink-faint); }
</style>
